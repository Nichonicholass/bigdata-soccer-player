   "source": [
    "BASE_DIR = os.path.dirname(os.path.abspath('__file__'))\n",
    "TRAIN_PATH = os.path.join(BASE_DIR, 'soccer_player_performances.csv')\n",
    "TEST_PATH  = os.path.join(BASE_DIR, 'soccer_player_test.csv')\n",
    "\n",
    "train_df = pd.read_csv(TRAIN_PATH)\n",
    "test_df  = pd.read_csv(TEST_PATH)\n",
    "\n",
    "print(f'Jumlah data training : {len(train_df)} baris')\n",
    "print(f'Jumlah data test     : {len(test_df)} baris')\n",
    "print(f'Jumlah kolom         : {len(train_df.columns)} kolom')"
   ]
